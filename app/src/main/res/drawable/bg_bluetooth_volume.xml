<?xml version="1.0" encoding="utf-8"?>
<!-- Boxes the Bluetooth volume so it cannot be mistaken for the ordinary volume above it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/bluetoothAccentDim" />
    <stroke android:width="1.5dp" android:color="?attr/bluetoothAccent" />
</shape>
