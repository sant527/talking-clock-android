<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings"
        app:titleTextColor="?android:attr/textColorPrimary" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/interval_heading" />

        <!-- Scrollable: six choices plus their unit do not fit across a phone. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/intervalGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/interval_minutes"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedback_heading" />

        <!-- A vertical list, not a toggle row: "Speak + vibrate" and "Vibrate only" cannot both
             fit across a phone, and a clipped label is worse than an extra line. -->
        <RadioGroup
            android:id="@+id/feedbackGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/feedbackSpeakButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_speak"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/feedbackBothButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_both"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/feedbackVibrateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_vibrate"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedback_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/vibrationLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.slider.Slider
            android:id="@+id/vibrationSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="500"
            android:valueFrom="500"
            android:valueTo="10000"
            android:visibility="gone"
            app:labelBehavior="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vibrationTestButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_test"
            android:visibility="gone"
            app:cornerRadius="14dp" />

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/countdown_heading" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/countdownSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/countdown_switch"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sameVoiceSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/countdown_same_voice"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/countdownExplainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/countdown_explainer"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/theme_heading" />

        <LinearLayout
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical" />

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clock_heading" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/clockStyleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digitalButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/clock_digital" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/analogButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/clock_analog" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- The label sits above rather than beside the tabs: side by side there was not enough
             width left for "Countdown", which clipped to "C...". The scroll view is a backstop
             for longer translations. -->
        <LinearLayout
            android:id="@+id/profileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/editing_profile"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/profileGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profileMainButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/profile_announcements" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profileCountdownButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/profile_countdown" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/volumeLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volumeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="0"
            android:valueTo="400"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/boostNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boost_note"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/boostWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/boost_note_high"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pitchLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/pitchSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="50"
            android:valueTo="200"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pitch_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rateLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/rateSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="50"
            android:valueTo="200"
            app:labelBehavior="gone" />

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_heading" />

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_loading"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/voice_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/sort_heading"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sortGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortAccentButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/sort_default" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortLabelButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/sort_by_label" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/voice_column"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_column_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- blocksDescendants: a freshly checked radio button would otherwise grab focus as it
             is added and drag the ScrollView down past the sliders. -->
        <LinearLayout
            android:id="@+id/voiceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_defaults" />

    </LinearLayout>
    </ScrollView>
</LinearLayout>
