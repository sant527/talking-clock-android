<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings"
        app:titleTextColor="?android:attr/textColorPrimary" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/theme_heading" />

        <LinearLayout
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical" />

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clock_heading" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/clockStyleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digitalButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/clock_digital" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/analogButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/clock_analog" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calls_heading" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/callsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calls_switch"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calls_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- The selector is the screen's spine: everything below it belongs to whichever
             announcement is picked here. All three are always listed, because this is also how
             you reach a switched-off one to turn it back on. -->
        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editing_profile" />

        <LinearLayout
            android:id="@+id/profileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/textColorSecondary"
            android:alpha="0.25" />

        <!-- ===== the selected announcement's own settings ===== -->

        <LinearLayout
            android:id="@+id/intervalSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SettingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_heading" />


            <TextView
                android:id="@+id/intervalHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/intervalBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="@string/interval_every"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/intervalGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/interval_minutes"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <include
                    android:id="@+id/intervalStyle"
                    layout="@layout/section_style" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/countdownSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SettingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/countdown_heading" />


            <TextView
                android:id="@+id/countdownExplainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/countdown_explainer"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/countdownBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/countdown_range_heading"
                    android:textAllCaps="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:scrollbars="none">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/countdownRangeGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/countdownRangeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <include
                    android:id="@+id/countdownStyle"
                    layout="@layout/section_style" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/majorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SettingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/major_heading" />


            <TextView
                android:id="@+id/majorHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/majorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="@string/interval_every"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/majorIntervalGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/interval_minutes"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <include
                    android:id="@+id/majorStyle"
                    layout="@layout/section_style" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== the selected announcement's voice ===== -->

        <LinearLayout
            android:id="@+id/voiceBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/volumeLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volumeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="0"
            android:valueTo="400"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/boostNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boost_note"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/boostWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/boost_note_high"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pitchLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/pitchSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="50"
            android:valueTo="200"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pitch_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rateLabel"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.Slider
            android:id="@+id/rateSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="50"
            android:valueTo="200"
            app:labelBehavior="gone" />

        <TextView
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_heading" />

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_loading"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/voice_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/sort_heading"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sortGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortAccentButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/sort_default" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortLabelButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/sort_by_label" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/voice_column"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_column_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- blocksDescendants: a freshly checked radio button would otherwise grab focus as it
             is added and drag the ScrollView down past the sliders. -->
        <LinearLayout
            android:id="@+id/voiceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_defaults" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
